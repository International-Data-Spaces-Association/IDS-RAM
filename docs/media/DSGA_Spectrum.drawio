<mxfile host="drawio"><diagram name="DSGA spectrum" id="DSGA spectrum"><mxGraphModel dx="1400" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="743" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="fontFamily=Segoe UI,Helvetica Neue,Arial;shape=singleArrow;html=1;arrowWidth=0.62;arrowSize=0.03;fillColor=#0BA2E3;gradientColor=#D6F0FB;gradientDirection=east;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="1150" height="56" as="geometry"/></mxCell><mxCell id="c2" value="Centralized" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="245" y="30" width="300" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Decentralized" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontColor=#0BA2E3;fontStyle=1;fontSize=18;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="30" width="280" height="36" as="geometry"/></mxCell><mxCell id="c4" value="Governance authority and information are distributed to participants; mandatory runtime dependencies on shared services are reduced" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="82" width="1150" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font style='font-size:18px'&gt;Central DSGA&lt;/font&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;One authority operates the&lt;br&gt;mandatory governance services&lt;/span&gt;" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0BA2E3;strokeColor=#0BA2E3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="135" width="370" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;font style='font-size:18px'&gt;Federated DSGA&lt;/font&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;Several authorities operate under&lt;br&gt;a common trust list&lt;/span&gt;" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0BA2E3;strokeColor=#0BA2E3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="135" width="370" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font style='font-size:18px'&gt;Decentral DSGA&lt;/font&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;Governance exercised collectively;&lt;br&gt;no shared mandatory infrastructure&lt;/span&gt;" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0BA2E3;strokeColor=#0BA2E3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="135" width="370" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Governance&lt;br&gt;authority" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="225" width="190" height="92" as="geometry"/></mxCell><mxCell id="c9" value="A single authority, typically an operations company, sets the rules and admits or removes participants" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="225" width="370" height="92" as="geometry"/></mxCell><mxCell id="c10" value="Several authorities share the function; rule-making is coordinated between them" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="225" width="370" height="92" as="geometry"/></mxCell><mxCell id="c11" value="Decisions are taken jointly by the participants, e.g. proposed and voted on a jointly operated ledger" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="225" width="370" height="92" as="geometry"/></mxCell><mxCell id="c12" value="Trust-root&lt;br&gt;topology" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="331" width="190" height="92" as="geometry"/></mxCell><mxCell id="c13" value="Single trust anchor or central identity provider" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="331" width="370" height="92" as="geometry"/></mxCell><mxCell id="c14" value="Common trust list of trusted trust anchors and credential issuers" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="331" width="370" height="92" as="geometry"/></mxCell><mxCell id="c15" value="Multiple independent issuers; each participant chooses which trust anchors and issuers to rely on" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="331" width="370" height="92" as="geometry"/></mxCell><mxCell id="c16" value="Runtime&lt;br&gt;dependencies" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="437" width="190" height="92" as="geometry"/></mxCell><mxCell id="c17" value="Participants query shared services (e.g. registries) during interactions - a potential single point of failure" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="437" width="370" height="92" as="geometry"/></mxCell><mxCell id="c18" value="Participants query the federated services during interactions" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="437" width="370" height="92" as="geometry"/></mxCell><mxCell id="c19" value="None mandated: governance data is held and evaluated locally; an Oracle of own choice where needed" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="437" width="370" height="92" as="geometry"/></mxCell><mxCell id="c20" value="Control, neutrality&lt;br&gt;and impartiality" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="543" width="190" height="92" as="geometry"/></mxCell><mxCell id="c21" value="The authority could favour or exclude participants: justify centralization and add safeguards" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="543" width="370" height="92" as="geometry"/></mxCell><mxCell id="c22" value="Power is spread across authorities, but safeguards are still required" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="543" width="370" height="92" as="geometry"/></mxCell><mxCell id="c23" value="No single actor holds power over the others; any shared component is optional" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="543" width="370" height="92" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Mitigation:&lt;/b&gt; operate governance services with high availability, or distribute governance data to participants, who cache it locally and evaluate it during interactions instead of querying the shared service" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0BA2E3;dashed=1;dashPattern=4 3;strokeWidth=1.5;fontColor=#333333;fontSize=14;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="655" width="760" height="64" as="geometry"/></mxCell><mxCell id="c25" value="" style="fontFamily=Segoe UI,Helvetica Neue,Arial;endArrow=block;endFill=1;html=1;strokeColor=#0BA2E3;strokeWidth=2;dashed=1;dashPattern=6 4;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="996" y="687" as="sourcePoint"/><mxPoint x="1195.0" y="687" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="Local caching moves the pattern toward the decentralized end" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;fontStyle=2;fontColor=#0BA2E3;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1010" y="657" width="370" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>