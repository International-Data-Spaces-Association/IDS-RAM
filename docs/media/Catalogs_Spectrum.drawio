<mxfile host="drawio"><diagram name="Catalog spectrum" id="Catalog spectrum"><mxGraphModel dx="1400" dy="959" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="959" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="fontFamily=Segoe UI,Helvetica Neue,Arial;shape=singleArrow;html=1;arrowWidth=0.62;arrowSize=0.03;fillColor=#0BA2E3;gradientColor=#D6F0FB;gradientDirection=east;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="1150" height="56" as="geometry"/></mxCell><mxCell id="c2" value="Centralized" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="245" y="30" width="300" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Decentralized" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontColor=#0BA2E3;fontStyle=1;fontSize=18;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="30" width="280" height="36" as="geometry"/></mxCell><mxCell id="c4" value="From a single central index to purely peer-to-peer discovery; metadata increasingly stays at its source" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="82" width="1150" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font style='font-size:18px'&gt;Central catalog&lt;/font&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;One Catalog Service aggregates metadata&lt;br&gt;from all participants into one index&lt;/span&gt;" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0BA2E3;strokeColor=#0BA2E3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="135" width="370" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;font style='font-size:18px'&gt;Federated catalogs&lt;/font&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;Several catalog services, e.g. per domain,&lt;br&gt;are aggregated or cross-queried&lt;/span&gt;" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0BA2E3;strokeColor=#0BA2E3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="135" width="370" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font style='font-size:18px'&gt;Decentral catalogs&lt;/font&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;No aggregated index; consumers query&lt;br&gt;each provider's catalog directly&lt;/span&gt;" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0BA2E3;strokeColor=#0BA2E3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="135" width="370" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Index and&lt;br&gt;operator" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="225" width="190" height="78" as="geometry"/></mxCell><mxCell id="c9" value="One index, operated by the DSGA, an operator under its authority, or an intermediary" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="225" width="370" height="78" as="geometry"/></mxCell><mxCell id="c10" value="Several indexes, typically per domain or sub-community; no single global operator" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="225" width="370" height="78" as="geometry"/></mxCell><mxCell id="c11" value="Each provider serves its own catalog; any local index is optional and participant-operated" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="225" width="370" height="78" as="geometry"/></mxCell><mxCell id="c12" value="Metadata&lt;br&gt;collection" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="315" width="190" height="78" as="geometry"/></mxCell><mxCell id="c13" value="Providers push (publish) and/or the catalog pulls (harvests) metadata into the index" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="315" width="370" height="78" as="geometry"/></mxCell><mxCell id="c14" value="Push and/or pull per catalog; catalogs combine their views by aggregation or cross-querying" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="315" width="370" height="78" as="geometry"/></mxCell><mxCell id="c15" value="Metadata stays at its source; consumers query providers over the Catalog Protocol" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="315" width="370" height="78" as="geometry"/></mxCell><mxCell id="c16" value="Network&lt;br&gt;reachability" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="405" width="190" height="78" as="geometry"/></mxCell><mxCell id="c17" value="Push: outbound to one well-known endpoint. Pull: allowlist only the catalog operator" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="405" width="370" height="78" as="geometry"/></mxCell><mxCell id="c18" value="Allowlist the small, governance-named set of catalog operators" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="405" width="370" height="78" as="geometry"/></mxCell><mxCell id="c19" value="All-to-all: every provider accepts discovery queries from every participant" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="405" width="370" height="78" as="geometry"/></mxCell><mxCell id="c20" value="Freshness and&lt;br&gt;availability" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="495" width="190" height="78" as="geometry"/></mxCell><mxCell id="c21" value="The index can go stale and is a runtime dependency for discovery (not for data transfer)" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="495" width="370" height="78" as="geometry"/></mxCell><mxCell id="c22" value="As central, but no single index whose failure stops all discovery" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="495" width="370" height="78" as="geometry"/></mxCell><mxCell id="c23" value="Always authoritative and current; no shared component whose failure stops discovery" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="495" width="370" height="78" as="geometry"/></mxCell><mxCell id="c24" value="Confidentiality&lt;br&gt;and neutrality" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="585" width="190" height="78" as="geometry"/></mxCell><mxCell id="c25" value="The operator sees what all participants offer and could favour or hide offerings" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="585" width="370" height="78" as="geometry"/></mxCell><mxCell id="c26" value="The aggregate view is split across several operators" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="585" width="370" height="78" as="geometry"/></mxCell><mxCell id="c27" value="No operator sees the whole space; each provider enforces visibility at its own endpoint" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="585" width="370" height="78" as="geometry"/></mxCell><mxCell id="c28" value="Search&lt;br&gt;experience" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E2E2;strokeColor=none;fontColor=#333333;fontStyle=1;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="675" width="190" height="78" as="geometry"/></mxCell><mxCell id="c29" value="One consistent place to search, with server-side query, ranking and normalization" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="230" y="675" width="370" height="78" as="geometry"/></mxCell><mxCell id="c30" value="A combined view across domains from one or a few places" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="675" width="370" height="78" as="geometry"/></mxCell><mxCell id="c31" value="No single searchable view: queries fan out and search moves to the consumer side" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0BA2E3;fontColor=#333333;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="675" width="370" height="78" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Mitigation:&lt;/b&gt; replication or high availability, consumer-side caching, credential-scoped visibility, and federation so that no single operator holds the whole index" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0BA2E3;dashed=1;dashPattern=4 3;strokeWidth=1.5;fontColor=#333333;fontSize=14;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="771" width="760" height="64" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Reachability mitigations&lt;/b&gt; - a shared relay or gateway, or a governance-defined connectivity fabric - reintroduce a shared component" style="fontFamily=Segoe UI,Helvetica Neue,Arial;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0BA2E3;dashed=1;dashPattern=4 3;strokeWidth=1.5;fontColor=#333333;fontSize=14;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="851" width="370" height="84" as="geometry"/></mxCell><mxCell id="c34" value="" style="fontFamily=Segoe UI,Helvetica Neue,Arial;endArrow=block;endFill=1;html=1;strokeColor=#0BA2E3;strokeWidth=2;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1004" y="893" as="sourcePoint"/><mxPoint x="805.0" y="893" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="Pushes the pattern back toward federated or central" style="fontFamily=Segoe UI,Helvetica Neue,Arial;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;fontStyle=2;fontColor=#0BA2E3;align=right;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="630" y="857" width="350" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>